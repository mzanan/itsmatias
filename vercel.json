{
  "crons": [
    {
      "path": "/api/cron/cleanup-deploys",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(videos|about|showcase)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
